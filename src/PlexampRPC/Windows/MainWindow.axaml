<Window x:Class="PlexampRPC.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlexampRPC"
        Width="310"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Icon.ico"
        CanResize="False">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid RowDefinitions="20,96,10,Auto">
            <Grid Grid.Row="1" Margin="5" HorizontalAlignment="Center" ColumnDefinitions="96,Auto">
                <Image x:Name="BackIcon" Grid.Column="0" Source="/Resources/PlexIcon.png" Width="96" Height="96" Stretch="UniformToFill" />
                <Image x:Name="UserIcon" Grid.Column="0" Width="96" Height="96" Stretch="UniformToFill" />

                <StackPanel x:Name="UserInfoPanel" Grid.Column="1" VerticalAlignment="Center" Margin="4">
                    <TextBlock x:Name="StatusTextBox" Text="Logging In..." Width="165" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                    <ComboBox x:Name="UserServerComboBox" Width="165" Margin="0,4,0,0" IsVisible="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource BorderBrushMuted}" Height="1" VerticalAlignment="Bottom" />
            <StackPanel Grid.Row="3" Margin="15,5,15,15" Spacing="1">
                <Grid Height="42" ColumnDefinitions="Auto,*">
                    <Image x:Name="DiscordAvatar" Grid.Column="0" Source="/Resources/PlexIcon.png" Height="32" Width="32" HorizontalAlignment="Left" Margin="5,0,8,0" />
                    <Grid Grid.Column="1" Height="40" RowDefinitions="*,Auto,Auto,*">
                        <TextBlock x:Name="DiscordUsername" Grid.Row="1" Text="Discord" Foreground="{StaticResource DiscordMutedBrush}" FontSize="16" Height="20" VerticalAlignment="Center" />
                        <Grid x:Name="DiscordStatus" Grid.Row="2" ColumnDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Column="0" Text=">" Foreground="{StaticResource DiscordMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="PreviewStatusListeningTo" Margin="4,0,0,0" Text="Music" Foreground="{StaticResource DiscordMutedBrush}" FontSize="12" Height="16" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </Grid>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="9">
                    <StackPanel>
                        <TextBlock x:Name="PreviewListeningTo" Text="Listening to Music" Foreground="#DDDDDD" FontSize="12" Height="18" Margin="0,-1,0,5" />
                        <DockPanel>
                            <Grid Height="64" Width="64" VerticalAlignment="Top" DockPanel.Dock="Left">
                                <Image x:Name="PreviewArt" Source="/Resources/PlexIcon.png" Height="64" Width="64" Stretch="UniformToFill" />
                                <Grid x:Name="PreviewPaused" IsVisible="False">
                                    <Border Margin="0,0,-6,-6" Height="28" Width="28" Background="{StaticResource PanelBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="14" />
                                    <Image Source="/Resources/PlexPaused.png" Margin="0,0,-4,-4" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </Grid>

                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="7,0,0,0">
                                <TextBlock x:Name="PreviewL1" Text="Title" Foreground="#DDDDDD" FontSize="14" Height="18" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PreviewL2" Text="Author" Foreground="#DDDDDD" FontSize="12" Height="18" Margin="0,0,0,-2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PreviewL3" Text="Album" Foreground="#DDDDDD" FontSize="12" Height="18" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" x:Name="PreviewTime" Margin="0,1,0,-2">
                                    <TextBlock x:Name="PreviewTimeStart" Text="00:00" Foreground="#DDDDDD" FontSize="12" Height="18" />
                                    <ProgressBar x:Name="PreviewTimeProgress" Width="100" Margin="8,0,8,2" Height="2" Minimum="0" Maximum="100" Value="50" />
                                    <TextBlock x:Name="PreviewTimeEnd" Text="00:00" Foreground="#DDDDDD" FontSize="12" Height="18" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <ProgressBar Grid.Row="2" x:Name="LoadingImage" Width="270" Height="4" Minimum="0" Maximum="100" IsIndeterminate="True" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,5,0" VerticalAlignment="Top">
            <Button Width="34" Height="20" Click="LogsButton_Click" Classes="shape" ToolTip.Tip="Open Log">
                <TextBlock Text="Log" FontSize="11" />
            </Button>
            <Button Width="54" Height="20" Click="SettingsButton_Click" Classes="shape" ToolTip.Tip="Open Settings">
                <TextBlock Text="Settings" FontSize="11" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
