<Window x:Class="DyviniaUtils.Dialogs.UpdateDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="5" RowDefinitions="*,36">
        <Border Grid.Row="0" Padding="5" Margin="5">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Header" Text="Update" FontSize="20" FontWeight="DemiBold" Margin="0,-4,0,2" />
                <Border BorderThickness="1" BorderBrush="{StaticResource BorderBrushMuted}" Height="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseNotes" TextWrapping="Wrap" Margin="8" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
        <Border Height="1" Background="{StaticResource BorderBrushMuted}" VerticalAlignment="Bottom" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button x:Name="InstallButton" Content="Install Update" Width="110" HorizontalAlignment="Right" Margin="0,5,5,5" />
            <Button x:Name="WebpageButton" Content="Open GitHub" Width="110" HorizontalAlignment="Right" Margin="0,5,5,5" />
            <Button x:Name="IgnoreButton" Content="Ignore" Width="110" HorizontalAlignment="Right" Margin="0,5,5,5" />
        </StackPanel>
    </Grid>
</Window>
