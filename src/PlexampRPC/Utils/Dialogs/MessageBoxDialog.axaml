<Window x:Class="DyviniaUtils.Dialogs.MessageBoxDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Height="150"
        Width="400">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="5" RowDefinitions="*,32">
        <Border Grid.Row="0" Padding="5">
            <TextBlock Text="Message" x:Name="MessageText" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </Border>
        <Border Height="1" Background="{StaticResource BorderBrushMuted}" VerticalAlignment="Bottom" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button x:Name="OKButton" Content="OK" Width="75" HorizontalAlignment="Right" Margin="0,5,5,5" />
            <Button x:Name="YesButton" Content="Yes" Width="75" HorizontalAlignment="Right" Margin="0,5,5,5" />
            <Button x:Name="NoButton" Content="No" Width="75" HorizontalAlignment="Right" Margin="0,5,5,5" />
            <Button x:Name="CancelButton" Content="Cancel" Width="75" HorizontalAlignment="Right" Margin="0,5,5,5" />
        </StackPanel>
    </Grid>
</Window>
